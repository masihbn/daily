# Copy this file to `.env.test` (gitignored) and fill in the values.
#
# Step D.4: the integration tier CREATES and DELETES rows, so it runs against
# a SECOND Supabase project — never the one holding the real logged data.
# Without these two values `npm test` refuses to run that tier at all. That
# refusal is deliberate: there is no fallback to production.
#
# Both values come from the TEST project's dashboard:
#   Project Settings -> Data API      -> Project URL
#   Project Settings -> API Keys      -> anon / publishable key
#
# Use the publishable (anon) key. Never a service_role / secret key: this file
# is a convenience for local test runs, not a secrets store, and the resolver
# does not need elevated access.
#
# `.env.test` is gitignored because THIS REPO IS PUBLIC. Real environment
# variables take precedence over this file, so a one-off override still works.

DAILY_TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
DAILY_TEST_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
